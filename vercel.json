{
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "api/index.py",
      "routePrefix": "/api",
      "framework": "fastapi",
      "includeFiles": ["backend/app/**"],
      "excludeFiles": ["backend/data/images/**", "backend/**/__pycache__/**"],
      "maxDuration": 60
    }
  }
}
